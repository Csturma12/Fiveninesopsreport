# Safe Sandbox Mode by default (flip ALLOW_LIVE_TAI_WRITES=true on Fly when testing live TAI writes)
ALLOW_LIVE_TAI_WRITES=false
PORT=5090
APP_BASE_URL=http://127.0.0.1:5090

# Live Supabase connection (same project nonqwidfqrklksjluloz as primary-freight-dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Staff Google Workspace OAuth (@primarycompanies.com, @shipfivenines.com, @fiveninesfreight.com)
# Local dev only: leave blank for the loopback-only local preview identity (no sign-in).
# PRODUCTION (NODE_ENV=production or a non-loopback APP_BASE_URL such as https://fivenines-ops.fly.dev):
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and SESSION_SECRET are all REQUIRED. The server refuses to
#   boot without them, /api/* fails closed (401/503), and AUTH_DISABLED is ignored. There is no preview user
#   and no session-secret fallback in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated random secret for signing session cookies (e.g. `openssl rand -hex 32`). Never reuse another key.
SESSION_SECRET=
# Local dev only: set to "true" to skip the Google sign-in even when OAuth vars are present. No effect in production.
# AUTH_DISABLED=false
GMAIL_FREIGHT_TOOLKIT_OAUTH_CLIENT_IDS=1093823548746-u96k7b3qro0a2vs6g5m1b9hfbn3441be.apps.googleusercontent.com,413556084944-jp47ckqu854t3cpccu318eqmn8c5ck50.apps.googleusercontent.com

# Owner-only login allowlist by default (chriss@primarycompanies.com, chris@shipfivenines.com).
# Add comma-separated emails or "*" when opening to all verified staff domain accounts.
ALLOWED_STAFF_EMAILS=

# TAI Cloud API & Webhooks
TAI_BASE_URL=https://primaryfreightllc.taicloud.net
TAI_WEBHOOK_SECRET=
# Optional: forward incoming webhooks to a second app URL
TEE_WEBHOOK_URL=

# Carrier/Buy Write-Back Poller
# Enabled by default ("true") scoped to "own" (fivenines-ops:* rows) + immediate execution on save.
TAI_WRITEBACK_POLLER_ENABLED=true
TAI_WRITEBACK_POLLER_SCOPE=own
