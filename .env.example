# Safe Sandbox Mode by default (flip ALLOW_LIVE_TAI_WRITES=true on Fly when testing live TAI writes)
ALLOW_LIVE_TAI_WRITES=false
PORT=5090
APP_BASE_URL=http://127.0.0.1:5090

# Live Supabase connection (same project nonqwidfqrklksjluloz as primary-freight-dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Staff Google Workspace OAuth (@primarycompanies.com, @shipfivenines.com, @fiveninesfreight.com)
# Leave blank locally for automatic local-dev preview; set on Fly for live Google Workspace sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
GMAIL_FREIGHT_TOOLKIT_OAUTH_CLIENT_IDS=1093823548746-u96k7b3qro0a2vs6g5m1b9hfbn3441be.apps.googleusercontent.com,413556084944-jp47ckqu854t3cpccu318eqmn8c5ck50.apps.googleusercontent.com

# Owner-only login allowlist by default (chriss@primarycompanies.com, chris@shipfivenines.com).
# Add comma-separated emails or "*" when opening to all verified staff domain accounts.
ALLOWED_STAFF_EMAILS=

# TAI Cloud API & Webhooks
TAI_BASE_URL=https://primaryfreightllc.taicloud.net
# Shared secret TAI sends on POST /api/webhooks/tai, /shipment and /invoice.
# REQUIRED in production (NODE_ENV=production): when unset, every inbound webhook is rejected with 503.
# Locally (NODE_ENV != production) leaving it blank enables "open mode" and unsigned webhooks are accepted.
# TAI must send it in one of these headers: `Authorization: Bearer <secret>` (or the bare value),
# `x-tai-webhook-secret: <secret>`, or `x-api-key: <secret>`. Comparison is constant-time.
TAI_WEBHOOK_SECRET=
# Legacy/discouraged: also accept the secret as `?secret=` on the webhook URL. Query strings land in
# access logs, so leave this unset unless the TAI Integration Source cannot send a header.
TAI_WEBHOOK_ALLOW_QUERY_SECRET=false
# POST /api/webhooks/tai/simulate (staff-only "Simulate Webhook" buttons) is disabled in production
# unless this is "true". Always enabled when NODE_ENV != production.
TAI_WEBHOOK_SIMULATE_ENABLED=false
# Optional: forward incoming webhooks to a second app URL
TEE_WEBHOOK_URL=

# Carrier/Buy Write-Back Poller
# Enabled by default ("true") scoped to "own" (fivenines-ops:* rows) + immediate execution on save.
TAI_WRITEBACK_POLLER_ENABLED=true
TAI_WRITEBACK_POLLER_SCOPE=own
