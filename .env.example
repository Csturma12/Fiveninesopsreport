# Safe Sandbox Mode by default (set ALLOW_LIVE_TAI_WRITES=true only when ready for live writes)
ALLOW_LIVE_TAI_WRITES=false
PORT=5090

# Optional read-only / write-back Supabase connection
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional TAI Cloud Base URL (defaults to https://primaryfreightllc.taicloud.net)
TAI_BASE_URL=https://primaryfreightllc.taicloud.net
