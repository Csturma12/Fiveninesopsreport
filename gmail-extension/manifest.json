{
  "manifest_version": 3,
  "name": "Five Nines Freight Toolkit (Compact v2)",
  "version": "2.2.0",
  "description": "Keyless MV3 Gmail side-panel shell for Primary Freight / Five Nines Operations with Gmail thread & attachment capture, reply insertion, and hosted toolkit deep-linking.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://fivenines-ops.fly.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Five Nines Freight Toolkit"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
